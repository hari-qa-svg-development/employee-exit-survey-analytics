# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
.env

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml

# Project-specific: generated artifacts (regenerate via scripts/)
data/raw/*.csv
data/processed/*.csv
reports/figures/*.png
reports/run_summary.md
reports/run_summary.json

# Keep directory structure with .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/figures/.gitkeep
